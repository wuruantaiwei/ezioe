          authDomain: "ioe-vtc.firebaseapp.com",
          projectId: "ioe-vtc",
          storageBucket: "ioe-vtc.appspot.com",
          messagingSenderId: "756201993363",
          appId: "1:756201993363:web:a95799b7849fcdde584966",
          measurementId: "G-E8TXKMY47H"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const analytics = getAnalytics(app);

